<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- The automation token grants control of protection to whoever can
             send a broadcast with it, so it stays on the device. -->
        <exclude domain="sharedpref" path="adfree_automation.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="adfree_automation.xml" />
    </device-transfer>
</data-extraction-rules>
